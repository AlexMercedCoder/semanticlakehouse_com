---
// /videos — the SemanticLakehouse.com explainer gallery.
// Animated 16:9 explainers rendered from a shared HyperFrames template: no
// narration and no audio track at all, so every point is on screen. The manifest
// is generated by the video workspace's sync-to-site.mjs
// (~/development/semanticlakehouse-videos).
import Layout from '../../layouts/Layout.astro';
import videos from '../../data/videos.json';

const SITE = 'https://semanticlakehouse.com';
const canonicalURL = `${SITE}/videos`;
const abs = (p: string) => `${SITE}${p}`;

const title = 'Semantic Layer Video Explainers | SemanticLakehouse';
const description =
  'Short silent video explainers on semantic layers and the lakehouse: metrics and dimensions, governed metrics, headless BI, AI agents and Apache Ossie.';

// The date this gallery was first published. VideoObject requires uploadDate.
const UPLOAD_DATE = '2026-08-08';

const publisher = {
  '@type': 'Organization',
  name: 'SemanticLakehouse.com',
  url: `${SITE}/`
};

const creator = {
  '@type': 'Person',
  '@id': `${SITE}/#person`,
  name: 'Alex Merced',
  url: 'https://whoisalexmerced.com'
};

const videoSchemas = videos.map((v) => ({
  '@type': 'VideoObject',
  '@id': `${canonicalURL}#${v.slug}`,
  name: v.title,
  description: v.description,
  thumbnailUrl: [abs(v.poster)],
  uploadDate: UPLOAD_DATE,
  duration: v.iso8601,
  contentUrl: abs(v.src),
  encodingFormat: 'video/mp4',
  width: v.width,
  height: v.height,
  inLanguage: 'en',
  isFamilyFriendly: true,
  keywords: v.keywords.join(', '),
  creator,
  publisher
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...videoSchemas,
    {
      '@type': 'CollectionPage',
      '@id': `${canonicalURL}#collection`,
      name: 'Semantic Layer Video Explainers',
      description,
      url: canonicalURL,
      inLanguage: 'en-US',
      isPartOf: { '@id': `${SITE}/#website` },
      author: { '@id': `${SITE}/#person` },
      mainEntity: {
        '@type': 'ItemList',
        name: 'Semantic Layer Video Explainers',
        numberOfItems: videos.length,
        itemListOrder: 'https://schema.org/ItemListOrderAscending',
        itemListElement: videos.map((v, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: `${canonicalURL}#${v.slug}`,
          name: v.title
        }))
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalURL}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Videos', item: canonicalURL }
      ]
    }
  ]
};

const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
---

<Layout {title} {description} {jsonLd} canonical={canonicalURL} ogType="video.other">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">&rsaquo;</span>
      <span aria-current="page">Videos</span>
    </nav>

    <header class="page-header">
      <p class="eyebrow">Video explainers</p>
      <h1>The semantic layer, in under a minute each</h1>
      <p class="lede">
        {videos.length > 0 ? `${videos.length} short` : 'Short'} animated explainers covering the questions that come up
        first when a team puts a semantic layer over its lakehouse: what the layer is, what a
        semantic model is made of, how a query resolves through it, and why agents change the
        stakes. There is no narration and no audio track at all, so every point is on screen and
        the clips read the same muted, in a meeting, or embedded in your own docs.
      </p>
    </header>

    {videos.length === 0 ? (
      <p class="empty">Videos are being published. Check back shortly.</p>
    ) : (
      <ul class="video-grid" role="list">
        {videos.map((v) => (
          <li class="video-card card" id={v.slug}>
            <div class="video-frame">
              <video
                class="video-el"
                controls
                playsinline
                muted
                preload="none"
                poster={v.poster}
                width={v.width}
                height={v.height}
                aria-label={`${v.title}, silent animated explainer, ${fmt(v.seconds)}`}
              >
                <source src={v.src} type="video/mp4" />
                <a href={v.src}>Download the MP4</a>.
              </video>
              <span class="video-duration" aria-hidden="true">{fmt(v.seconds)}</span>
            </div>

            <div class="video-body">
              <h2 class="video-name">
                <span class="video-index">{String(v.index).padStart(2, '0')}</span>
                {v.title}
              </h2>
              <p class="video-caption">{v.description}</p>
              <ul class="video-points" role="list">
                {v.beats.map((b) => (<li>{b}</li>))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    )}

    <p class="note">
      Silent by design: no narration, no music. Hover to preview, click to play, or download any
      MP4 and reuse it. Terms used in these clips are defined in the
      <a href="/knowledge-base">knowledge base</a>.
    </p>
  </div>
</Layout>

<style>
  .breadcrumb {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-size: var(--text-body-sm);
    color: var(--color-slate-hint);
    padding-top: 2rem;
  }
  .breadcrumb a {
    color: var(--color-slate-hint);
  }
  .breadcrumb a:hover {
    color: var(--color-deep-violet);
  }
  .page-header {
    max-width: 820px;
    padding: 2.5rem 0 3.5rem;
  }
  .eyebrow {
    font-family: var(--font-whyte-inktrap-mono);
    font-size: var(--text-body-sm);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-deep-violet);
    margin-bottom: 1rem;
  }
  .page-header h1 {
    font-size: var(--text-heading);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }
  .lede {
    color: var(--color-slate-hint);
    font-size: 1.05rem;
    margin-top: 1.5rem;
  }
  .video-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 2.5rem;
  }
  @media (max-width: 420px) {
    .video-grid {
      grid-template-columns: 1fr;
    }
  }
  .video-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    scroll-margin-top: 6rem;
  }
  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #060809;
  }
  .video-el {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .video-duration {
    position: absolute;
    right: 0.5rem;
    top: 0.5rem;
    pointer-events: none;
    background: rgba(0, 0, 0, 0.65);
    color: var(--color-cloud-whisper);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    font-family: var(--font-whyte-inktrap-mono);
    font-size: 0.75rem;
  }
  .video-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .video-name {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1.35rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
  }
  .video-index {
    font-family: var(--font-whyte-inktrap-mono);
    font-size: 0.85rem;
    color: var(--color-deep-violet);
  }
  .video-caption {
    color: var(--color-slate-hint);
    font-size: 0.95rem;
  }
  .video-points {
    list-style: none;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .video-points li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.9rem;
    color: var(--color-slate-hint);
  }
  .video-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.5rem;
    height: 1px;
    background: var(--color-deep-violet);
  }
  .note {
    margin: 4rem 0 2rem;
    text-align: center;
    color: var(--color-slate-hint);
    font-size: 0.9rem;
  }
  .note a {
    color: var(--color-deep-violet);
  }
  .empty {
    padding: 4rem 0;
    text-align: center;
    color: var(--color-slate-hint);
  }
</style>

<script>
  // The clips carry no audio track, so a muted hover-preview costs the viewer
  // nothing and autoplay policies never block it. Three behaviours only:
  //   1. hover (fine-pointer devices only) previews from the start;
  //   2. leaving resets to the poster, unless the viewer pressed play;
  //   3. starting one video pauses whichever one was already going.
  function setupVideoGallery() {
    const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.video-el'));
    if (!videos.length) return;

    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const intentional = new WeakSet<HTMLVideoElement>();

    videos.forEach((video) => {
      video.addEventListener('play', () => {
        videos.forEach((other) => {
          if (other !== video && !other.paused) other.pause();
        });
      });

      // A click on the native controls is a deliberate play — stop treating
      // this element as a hover preview from then on.
      video.addEventListener('click', () => intentional.add(video));

      if (!canHover) return;

      video.addEventListener('mouseenter', () => {
        if (intentional.has(video)) return;
        video.currentTime = 0;
        void video.play().catch(() => {});
      });

      video.addEventListener('mouseleave', () => {
        if (intentional.has(video)) return;
        video.pause();
        video.currentTime = 0;
      });
    });
  }

  setupVideoGallery();
</script>
