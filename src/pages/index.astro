---
import Layout from '../layouts/Layout.astro';
import Parser from 'rss-parser';
import { books } from '../utils/data';
import videos from '../data/videos.json';
import HomeFilmShowcase from '../components/HomeFilmShowcase.astro';

// Fetch latest 3 blogs
let latestBlogs: { title: string, url: string, date: string }[] = [];
try {
  const parser = new Parser();
  const feed = await parser.parseURL('https://datalakehousehub.com/rss.xml');
  latestBlogs = feed.items
    .filter(item => {
      const url = item.link || '';
      return url.startsWith('https://datalakehousehub.com/blog/') &&
             !url.endsWith('/blog/index/') &&
             !url.endsWith('/blog/index');
    })
    .slice(0, 3)
    .map(item => ({
      title: item.title || 'Untitled',
      url: item.link || '#',
      date: item.pubDate ? new Date(item.pubDate).toLocaleDateString() : 'Recent'
    }));
} catch (e) {
  console.error("Failed to fetch RSS feed", e);
}

// Get main books (O'Reilly / Manning)
const mainBooks = books.slice(0, 2);
const featuredVideos = videos.slice(0, 3);

// Answer-first Q&A, mirrored into FAQPage structured data so answer engines can
// quote it directly. Keep the on-page copy and the schema identical.
const faqs = [
  {
    q: 'What is a semantic lakehouse?',
    a: 'A semantic lakehouse is a data lakehouse with a governed semantic layer on top of it. The lakehouse keeps data in open files and open table formats such as Apache Iceberg on storage you own. The semantic layer defines what the numbers in those tables mean, as named metrics, dimensions and relationships. Together they let dashboards, notebooks and AI agents answer from the same definitions over the same open data.'
  },
  {
    q: 'What is a semantic layer?',
    a: 'A semantic layer is the executable bridge between physical tables and the questions people ask. It holds metrics with their exact filters and time logic, the dimensions that slice them, and the declared keys that make joins safe. Because the definitions run rather than sit in a wiki, every consumer that asks for revenue gets the same number.'
  },
  {
    q: 'How is a semantic layer different from a data catalog?',
    a: 'A catalog tells you what data exists, who owns it, and who may see it. A semantic layer tells you what the data means and can execute that meaning as a query. Most lakehouse architectures run both: the catalog governs access and lineage over the tables, the semantic layer governs definitions over the catalog.'
  },
  {
    q: 'Why do AI agents need a semantic layer?',
    a: 'Protocols like MCP connect an agent to your data but carry no opinion about meaning, so an agent pointed at raw schemas infers formulas from column names and reports guesses with confidence. Grounded in governed metrics, it queries an endorsed definition and can cite it. Widely cited text-to-SQL evaluations land near 40 percent accuracy against raw schemas and above 80 percent when the model resolves through a governed semantic layer.'
  },
  {
    q: 'What is Apache Ossie?',
    a: 'Apache Ossie is the incubating Apache Software Foundation project formerly known as Open Semantic Interchange. It is a vendor-neutral YAML specification for metrics, dimensions and relationships, so semantic definitions can move between BI, analytics and AI platforms instead of being locked to one dialect. It launched as an industry initiative in 2025, published its specification under Apache 2.0 in January 2026, and entered the Apache Incubator in June 2026 with Snowflake, dbt Labs, Dremio and Salesforce among its backers.'
  },
  {
    q: 'What is headless BI?',
    a: 'Headless BI runs the semantic model as a service rather than as a feature inside one dashboard tool. Definitions live behind an API that speaks SQL, REST, JDBC/ODBC, Arrow Flight SQL or MCP, so every consumer resolves against the same model and the front end becomes replaceable.'
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://semanticlakehouse.com/#faq",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---

<Layout
  title="Semantic Lakehouse: Semantic Layers on Open Data"
  description="What a semantic layer is, how it works, and how it pairs with an open lakehouse: metrics, dimensions, governed definitions, headless BI and AI agents."
  jsonLd={faqJsonLd}
>
  <section class="hero">
    <svg class="hero-constellation" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="sl-fade" x1="0" y1="0" x2="1440" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#fff"/>
          <stop offset="0.16" stop-color="#fff"/>
          <stop offset="0.215" stop-color="#000"/>
          <stop offset="0.785" stop-color="#000"/>
          <stop offset="0.84" stop-color="#fff"/>
          <stop offset="1" stop-color="#fff"/>
        </linearGradient>
        <mask id="sl-mask"><rect width="1440" height="800" fill="url(#sl-fade)"/></mask>
      </defs>

      <g mask="url(#sl-mask)">
        <!-- scattered sources resolving to one shared definition -->
        <g>
          <line class="sl-edge" x1="40" y1="260" x2="118" y2="400"/>
          <line class="sl-edge" x1="120" y1="220" x2="118" y2="400"/>
          <line class="sl-edge" x1="200" y1="300" x2="118" y2="400"/>
          <line class="sl-edge" x1="70" y1="365" x2="118" y2="400"/>
          <line class="sl-edge" x1="196" y1="405" x2="118" y2="400"/>
          <line class="sl-edge" x1="30" y1="470" x2="118" y2="400"/>
          <line class="sl-edge" x1="112" y1="528" x2="118" y2="400"/>
          <line class="sl-edge" x1="190" y1="585" x2="118" y2="400"/>
          <line class="sl-edge" x1="1400" y1="260" x2="1322" y2="400"/>
          <line class="sl-edge" x1="1320" y1="220" x2="1322" y2="400"/>
          <line class="sl-edge" x1="1240" y1="300" x2="1322" y2="400"/>
          <line class="sl-edge" x1="1370" y1="365" x2="1322" y2="400"/>
          <line class="sl-edge" x1="1244" y1="405" x2="1322" y2="400"/>
          <line class="sl-edge" x1="1410" y1="470" x2="1322" y2="400"/>
          <line class="sl-edge" x1="1328" y1="528" x2="1322" y2="400"/>
          <line class="sl-edge" x1="1250" y1="585" x2="1322" y2="400"/>
        </g>
        <g>
          <line class="sl-beam" pathLength="100" x1="40" y1="260" x2="118" y2="400" style="animation-duration:6.0s;animation-delay:-0.0s"/>
          <line class="sl-beam" pathLength="100" x1="120" y1="220" x2="118" y2="400" style="animation-duration:7.4s;animation-delay:-0.9s"/>
          <line class="sl-beam" pathLength="100" x1="200" y1="300" x2="118" y2="400" style="animation-duration:8.8s;animation-delay:-1.8s"/>
          <line class="sl-beam" pathLength="100" x1="70" y1="365" x2="118" y2="400" style="animation-duration:10.2s;animation-delay:-2.7s"/>
          <line class="sl-beam" pathLength="100" x1="196" y1="405" x2="118" y2="400" style="animation-duration:6.0s;animation-delay:-3.6s"/>
          <line class="sl-beam" pathLength="100" x1="30" y1="470" x2="118" y2="400" style="animation-duration:7.4s;animation-delay:-4.5s"/>
          <line class="sl-beam" pathLength="100" x1="112" y1="528" x2="118" y2="400" style="animation-duration:8.8s;animation-delay:-5.4s"/>
          <line class="sl-beam" pathLength="100" x1="190" y1="585" x2="118" y2="400" style="animation-duration:10.2s;animation-delay:-6.3s"/>
          <line class="sl-beam" pathLength="100" x1="1400" y1="260" x2="1322" y2="400" style="animation-duration:6.0s;animation-delay:-2.3s"/>
          <line class="sl-beam" pathLength="100" x1="1320" y1="220" x2="1322" y2="400" style="animation-duration:7.4s;animation-delay:-3.2s"/>
          <line class="sl-beam" pathLength="100" x1="1240" y1="300" x2="1322" y2="400" style="animation-duration:8.8s;animation-delay:-4.1s"/>
          <line class="sl-beam" pathLength="100" x1="1370" y1="365" x2="1322" y2="400" style="animation-duration:10.2s;animation-delay:-5.0s"/>
          <line class="sl-beam" pathLength="100" x1="1244" y1="405" x2="1322" y2="400" style="animation-duration:6.0s;animation-delay:-5.9s"/>
          <line class="sl-beam" pathLength="100" x1="1410" y1="470" x2="1322" y2="400" style="animation-duration:7.4s;animation-delay:-6.8s"/>
          <line class="sl-beam" pathLength="100" x1="1328" y1="528" x2="1322" y2="400" style="animation-duration:8.8s;animation-delay:-7.7s"/>
          <line class="sl-beam" pathLength="100" x1="1250" y1="585" x2="1322" y2="400" style="animation-duration:10.2s;animation-delay:-8.6s"/>
        </g>
        <g>
          <circle class="sl-star" cx="40" cy="260" r="2.5" style="animation-delay:-0.0s"/>
          <circle class="sl-star" cx="120" cy="220" r="2.5" style="animation-delay:-0.8s"/>
          <circle class="sl-star" cx="200" cy="300" r="2.5" style="animation-delay:-1.6s"/>
          <circle class="sl-star" cx="70" cy="365" r="2.5" style="animation-delay:-2.4s"/>
          <circle class="sl-star" cx="196" cy="405" r="2.5" style="animation-delay:-3.2s"/>
          <circle class="sl-star" cx="30" cy="470" r="2.5" style="animation-delay:-4.0s"/>
          <circle class="sl-star" cx="112" cy="528" r="2.5" style="animation-delay:-4.8s"/>
          <circle class="sl-star" cx="190" cy="585" r="2.5" style="animation-delay:-5.6s"/>
          <circle class="sl-star" cx="1400" cy="260" r="2.5" style="animation-delay:-1.7s"/>
          <circle class="sl-star" cx="1320" cy="220" r="2.5" style="animation-delay:-2.5s"/>
          <circle class="sl-star" cx="1240" cy="300" r="2.5" style="animation-delay:-3.3s"/>
          <circle class="sl-star" cx="1370" cy="365" r="2.5" style="animation-delay:-4.1s"/>
          <circle class="sl-star" cx="1244" cy="405" r="2.5" style="animation-delay:-4.9s"/>
          <circle class="sl-star" cx="1410" cy="470" r="2.5" style="animation-delay:-5.7s"/>
          <circle class="sl-star" cx="1328" cy="528" r="2.5" style="animation-delay:-6.5s"/>
          <circle class="sl-star" cx="1250" cy="585" r="2.5" style="animation-delay:-7.3s"/>
        </g>
        <circle class="sl-hub" cx="118" cy="400" r="9"/>
        <circle class="sl-hub" cx="1322" cy="400" r="9" style="animation-delay:-2.5s"/>
        <circle class="sl-hub-ring" cx="118" cy="400" r="9"/>
        <circle class="sl-hub-ring" cx="1322" cy="400" r="9" style="animation-delay:-4s"/>
      </g>
    </svg>
    <div class="container hero-content">
      <p class="eyebrow">Semantic layers &middot; Lakehouse &middot; Agentic analytics</p>
      <h1>The <span class="highlight">Semantic Lakehouse</span></h1>
      <p class="subtitle">Open tables settle where your data lives. A semantic layer settles what it means. Put both in place and every dashboard, notebook and agent answers from the same definitions.</p>
      <div class="cta-buttons">
        <a href="#concepts" class="btn">Start with the four ideas</a>
        <a href="/videos" class="btn btn-outline">Watch the explainers</a>
      </div>
    </div>
  </section>

  <HomeFilmShowcase eyebrow="Featured music video" heading="From Iceberg tables to shared meaning" intro="See how an open lakehouse creates the governed, portable foundation that semantic layers and AI systems can trust." films={[{
    title: 'The Iceberg Open Lakehouse',
    description: 'A beat-synced tour from open storage and table metadata to catalogs, engines, governance, and semantics.',
    src: 'https://opendatalakehouse.com/the-iceberg-open-lakehouse.mp4',
    poster: 'https://opendatalakehouse.com/the-iceberg-open-lakehouse-poster.jpg',
    runtime: '7:50',
  }]} />

  <section id="concepts" class="container concepts-section">
    <h2 class="section-heading">Four ideas this site keeps coming back to</h2>
    <div class="concepts-grid">
      <div class="card">
        <h3>Semantic layer</h3>
        <p>The executable bridge between physical tables and the questions people ask. It holds the metrics, dimensions and relationships every consumer resolves against, so a word like revenue means one thing across the company and to every AI agent reading it.</p>
        <a href="/knowledge-base/semantic-layer" class="card-link">Semantic layer in the knowledge base</a>
      </div>

      <div class="card">
        <h3>Data lakehouse</h3>
        <p>Data kept in open files and open table formats on storage you own, with the transactions, schema evolution and time travel a warehouse gave you. Apache Iceberg is how most teams get there, and the engine stops being the thing that holds the data hostage.</p>
        <a href="/knowledge-base/apache-iceberg" class="card-link">Apache Iceberg in the knowledge base</a>
      </div>

      <div class="card">
        <h3>Agentic analytics</h3>
        <p>Agents do not stop at answering. They plan, query and act. What they believe your business means comes from the context you hand them, which is why governed definitions decide whether their answers hold up.</p>
        <a href="/knowledge-base/agentic-analytics" class="card-link">Agentic analytics in the knowledge base</a>
      </div>

      <div class="card">
        <h3>Query federation</h3>
        <p>Query data where it already sits instead of copying it somewhere first. One access point across sources, with joins and filters pushed down to each one, so the semantic layer can span systems that were never going to merge.</p>
        <a href="/knowledge-base/query-federation" class="card-link">Query federation in the knowledge base</a>
      </div>
    </div>
  </section>

  {featuredVideos.length > 0 && (
    <section class="container videos-teaser">
      <h2 class="section-heading">Short explainers, no narration</h2>
      <p class="section-lede">Animated 16:9 breakdowns of the ideas above. Every point is on screen, so they read the same muted or embedded in your own docs.</p>
      <div class="video-teaser-grid">
        {featuredVideos.map(v => (
          <a href={`/videos#${v.slug}`} class="card video-teaser-card">
            <img src={v.poster} alt={`Title card for the explainer video ${v.title}`} width="1920" height="1080" loading="lazy" decoding="async" />
            <h3>{v.title}</h3>
          </a>
        ))}
      </div>
      <div class="view-all">
        <a href="/videos" class="btn btn-outline">All {videos.length} explainers</a>
      </div>
    </section>
  )}

  <section class="container latest-content">
    <div class="split-section">
      <div class="latest-blogs">
        <h2 class="section-heading">Latest from the Hub</h2>
        <div class="blog-list">
          {latestBlogs.map(blog => (
            <a href={blog.url} target="_blank" rel="noopener noreferrer" class="card mini-blog-card">
              <h3>{blog.title}</h3>
              <span class="date">{blog.date}</span>
            </a>
          ))}
        </div>
        <div class="view-all">
          <a href="/blog" class="btn btn-outline">View all articles</a>
        </div>
      </div>

      <div class="featured-books">
        <h2 class="section-heading">Books</h2>
        <div class="books-grid">
          {mainBooks.map(book => (
            <a href={book.amazon_url} target="_blank" rel="noopener noreferrer" class="card mini-book-card">
              <img
                src={book.cover_image_url}
                alt={`Cover of ${book.title}`}
                loading="lazy"
                decoding="async"
              />
            </a>
          ))}
        </div>
        <div class="view-all">
          <a href="/reading" class="btn btn-outline">The full reading list</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container faq-section">
    <h2 class="section-heading">Questions people ask first</h2>
    <div class="faq-list">
      {faqs.map(f => (
        <details class="card faq-item">
          <summary><h3>{f.q}</h3></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="dremio-section container">
    <div class="card dremio-card">
      <h2>Where Dremio fits</h2>
      <p>Dremio runs the engine, the catalog and the semantic layer in one place, over Iceberg tables in storage you own. Governed definitions sit beside the data they describe, Reflections accelerate them to interactive speed, and the same access rules cover a dashboard query and an agent's MCP call.</p>
      <a href="https://www.dremio.com" target="_blank" rel="noopener noreferrer" class="btn">Explore Dremio</a>
    </div>
  </section>

  <section class="container author-section">
    <div class="card author-card">
      <h2>Who writes this</h2>
      <p>SemanticLakehouse.com is written by <a href="https://whoisalexmerced.com" target="_blank" rel="noopener">Alex Merced</a>, Open Lakehouse &amp; AI Advocate, Author &amp; Technologist. He co-wrote <em>Apache Iceberg: The Definitive Guide</em> (O'Reilly) and <em>Architecting an Apache Iceberg Lakehouse</em> (Manning), and works on developer relations at Dremio.</p>
      <p>The same ideas run across <a href="https://datalakehousehub.com" target="_blank" rel="noopener">DataLakehouseHub.com</a>, <a href="https://iceberglakehouse.com" target="_blank" rel="noopener">IcebergLakehouse.com</a> and <a href="https://agenticlakehouse.com" target="_blank" rel="noopener">AgenticLakehouse.com</a>.</p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 0;
    text-align: center;
    background: var(--gradient-cosmic-gradient-a);
    background-color: var(--surface-deep-space-canvas);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* Scattered sources resolving into one definition, drawn as a constellation.
     Desktop only, where the centred hero leaves clear margins. */
  .hero-constellation {
    display: none;
  }

  @media (min-width: 1200px) {
    .hero-constellation {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    }
  }

  .sl-edge {
    stroke: var(--color-slate-hint);
    stroke-width: 1;
    opacity: 0.25;
  }

  .sl-beam {
    stroke: var(--color-deep-violet);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 10 90;
    animation: slBeam 7s linear infinite;
  }

  .sl-star {
    fill: var(--color-cloud-whisper);
    animation: slTwinkle 5s ease-in-out infinite;
  }

  .sl-hub {
    fill: var(--color-deep-violet);
    animation: slTwinkle 4s ease-in-out infinite;
  }

  .sl-hub-ring {
    fill: none;
    stroke: var(--color-deep-violet);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    animation: slHalo 6s ease-out infinite;
  }

  @keyframes slBeam {
    from { stroke-dashoffset: 100; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes slTwinkle {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  @keyframes slHalo {
    0% { transform: scale(1); opacity: 0.6; }
    75%, 100% { transform: scale(3.4); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sl-beam, .sl-star, .sl-hub, .sl-hub-ring { animation: none; }
    .sl-beam { stroke-dashoffset: 55; }
    .sl-star, .sl-hub { opacity: 0.7; }
    .sl-hub-ring { opacity: 0.35; }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
  }
  .eyebrow {
    font-family: var(--font-whyte-inktrap-mono);
    font-size: var(--text-body-sm);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-deep-violet);
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    margin-bottom: 1.5rem;
    font-family: var(--font-grandslang);
  }
  .highlight {
    color: var(--color-deep-violet);
  }
  .subtitle {
    font-size: var(--text-subheading);
    color: var(--color-cloud-whisper);
    letter-spacing: var(--tracking-subheading);
    margin-bottom: 2.5rem;
  }
  .cta-buttons {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .section-heading {
    font-family: var(--font-whyte-inktrap-mono);
    text-transform: uppercase;
    font-size: clamp(1.1rem, 3.5vw, var(--text-heading-sm));
    line-height: 1.3;
    letter-spacing: 0.18em;
    color: var(--color-code-ghost);
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .section-lede {
    text-align: center;
    color: var(--color-slate-hint);
    max-width: 640px;
    margin: 0 auto 2.5rem;
  }
  .concepts-section {
    margin-top: 4rem;
  }
  .concepts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2.5rem;
  }
  /* Four cards read as a 2x2 block; auto-fit left one card stranded on a row. */
  @media (min-width: 700px) {
    .concepts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .concepts-grid p {
    color: var(--color-slate-hint);
    margin-bottom: 1.25rem;
  }
  .card-link {
    font-size: var(--text-body-sm);
    color: var(--color-deep-violet);
    font-weight: 500;
  }
  .videos-teaser,
  .latest-content,
  .faq-section {
    margin-top: 5rem;
  }
  .video-teaser-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .video-teaser-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .video-teaser-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .video-teaser-card h3 {
    font-size: var(--text-body);
    margin: 0;
    padding: 1.25rem;
  }
  .split-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
  @media (max-width: 768px) {
    .split-section {
      grid-template-columns: 1fr;
    }
    .hero {
      padding: 3.5rem 0;
    }
  }
  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .mini-blog-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border-radius: var(--radius-cards);
  }
  .mini-blog-card h3 {
    margin: 0;
    font-size: var(--text-body);
    flex: 1;
    color: var(--color-cloud-whisper);
  }
  .date {
    color: var(--color-slate-hint);
    font-size: var(--text-body-sm);
    margin-left: 1rem;
    white-space: nowrap;
  }
  .books-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .mini-book-card {
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: var(--radius-cards);
    overflow: hidden;
  }
  .mini-book-card img {
    width: 100%;
    max-height: 350px;
    aspect-ratio: 2 / 3;
