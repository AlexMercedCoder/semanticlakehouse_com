---
import Layout from '../layouts/Layout.astro';
import { books } from '../utils/data';
---

<Layout
  title="Books on the Lakehouse and AI | SemanticLakehouse.com"
  description="Books on data lakehouses, Apache Iceberg, semantic layers and AI written by Alex Merced, including titles from O'Reilly and Manning."
>
  <div class="container page-header">
    <h1>Reading list</h1>
    <p>Books on the lakehouse, Apache Iceberg, semantic layers and AI, written by Alex Merced. Two of them come from O'Reilly and Manning; the rest cover the ground around them.</p>
  </div>

  <div class="container books-grid">
    {books.filter(b => b.category === 'tech').map(book => (
      <a href={book.amazon_url} target="_blank" rel="noopener noreferrer" class="card book-card">
        <div class="cover-wrapper">
          <img 
            src={book.cover_image_url} 
            alt={`Cover of ${book.title}`} 
            loading="lazy"
            decoding="async"
          />
        </div>
        <h2>{book.title}</h2>
        <span class="read-more">Learn More &rarr;</span>
      </a>
    ))}
  </div>
</Layout>

<style>
  .page-header {
    text-align: center;
    padding: 4rem 0 2rem;
  }
  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    justify-items: center;
  }
  .book-card {
    width: 100%;
    max-width: 300px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cover-wrapper {
    width: 100%;
    border-radius: 8px;
    margin-bottom: 1.5rem;
  }
  .cover-wrapper img {
    width: 100%;
    max-height: 400px;
    aspect-ratio: 2 / 3;
    object-fit: contain;
    border-radius: 8px;
  }
  .book-card h2 {
    font-size: 1.2rem;
    line-height: 1.4;
    letter-spacing: normal;
    font-weight: 700;
    margin-bottom: 1rem;
    flex-grow: 1;
  }
  .read-more {
    color: var(--secondary);
    font-weight: 600;
  }
</style>
