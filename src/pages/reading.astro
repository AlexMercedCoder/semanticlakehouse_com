---
import Layout from '../layouts/Layout.astro';
import bookData from '../data/books.json';

// Generated from the entity layer; see alexmercedcom/scripts/build-network-booklists.mjs.
const { books, count, totalInCatalog, catalog, intro } = bookData;
---

<Layout
  title="Books on the Lakehouse and AI | SemanticLakehouse.com"
  description="Books on data lakehouses, Apache Iceberg, semantic layers and AI written by Alex Merced, including titles from O'Reilly and Manning."
>
  <div class="container page-header">
    <h1>Reading list</h1>
    <p>{intro}</p>
    <p class="reading-meta">
      {count} of {totalInCatalog} titles.
      <a href={catalog} target="_blank" rel="noopener noreferrer">See the complete catalog</a>
    </p>
  </div>

  <div class="container books-grid">
    {books.map(book => (
      <article class="card book-card">
        <a class="cover-wrapper" href={book.canonicalPage} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
          <img src={book.cover} alt="" loading="lazy" decoding="async" />
        </a>
        <h2><a href={book.canonicalPage} target="_blank" rel="noopener noreferrer">{book.title}</a></h2>
        {book.publisher && <p class="book-publisher">{book.publisher}</p>}
        <p class="book-links">
          <a href={book.canonicalPage} target="_blank" rel="noopener noreferrer">Details</a>
          <a href={book.amazon} target="_blank" rel="noopener noreferrer">Buy on Amazon</a>
        </p>
      </article>
    ))}
  </div>
</Layout>

<style>
  .page-header {
    text-align: center;
    padding: 4rem 0 2rem;
  }
  .reading-meta {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    opacity: 0.8;
  }
  .book-publisher {
    margin: 0.25rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .book-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    justify-items: center;
  }
  .book-card {
    width: 100%;
    max-width: 300px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cover-wrapper {
    width: 100%;
    border-radius: 8px;
    margin-bottom: 1.5rem;
  }
  .cover-wrapper img {
    width: 100%;
    max-height: 400px;
    aspect-ratio: 2 / 3;
    object-fit: contain;
    border-radius: 8px;
  }
  .book-card h2 {
    font-size: 1.2rem;
    line-height: 1.4;
    letter-spacing: normal;
    font-weight: 700;
    margin-bottom: 1rem;
    flex-grow: 1;
  }
  .read-more {
    color: var(--secondary);
    font-weight: 600;
  }
</style>
