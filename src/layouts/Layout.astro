---
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  jsonLd?: object;
  canonical?: string;
  ogType?: string;
}

const { title, description, jsonLd, canonical, ogType } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/videos', label: 'Videos' },
  { href: '/blog', label: 'Articles' },
  { href: '/reading', label: 'Reading' },
  { href: '/knowledge-base', label: 'Knowledge Base' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <SEO title={title} description={description} jsonLd={jsonLd} canonical={canonical} ogType={ogType} />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;700&family=Outfit:wght@300;400;500;700;800&family=Space+Mono&display=swap" rel="stylesheet">
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="navbar">
      <div class="container nav-container">
        <a href="/" class="logo">SemanticLakehouse.com</a>
        <nav aria-label="Primary">
          <ul class="nav-links">
            {navLinks.map(link => (
              <li>
                <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    
    <main id="main-content">
      <slot />
    </main>

    <footer>
      <div class="container footer-content">
        <nav class="footer-nav" aria-label="Footer">
          <ul>
            {navLinks.map(link => (<li><a href={link.href}>{link.label}</a></li>))}
          </ul>
        </nav>
        <p class="footer-about">
          Written by <a href="https://whoisalexmerced.com" target="_blank" rel="noopener">Alex Merced</a>,
          Open Lakehouse &amp; AI Advocate, Author &amp; Technologist.
        </p>
        <div class="footer-links">
          <h2 class="footer-heading">Elsewhere</h2>
          <ul>
            <li><a href="https://alexmerced.com" target="_blank" rel="noopener">AlexMerced.com</a></li>
            <li><a href="https://datalakehousehub.com" target="_blank" rel="noopener">DataLakehouseHub.com</a></li>
            <li><a href="https://iceberglakehouse.com" target="_blank" rel="noopener">IcebergLakehouse.com</a></li>
            <li><a href="https://dataengnr.com" target="_blank" rel="noopener">DataEngnr.com</a></li>
            <li><a href="https://opendatalakehouse.com" target="_blank" rel="noopener">OpenDataLakehouse.com</a></li>
            <li><a href="https://agenticlakehouse.com" target="_blank" rel="noopener">AgenticLakehouse.com</a></li>
            <li><a href="https://alexmerceddata.com" target="_blank" rel="noopener">AlexMercedData.com</a></li>
            <li><a href="https://whoisalexmerced.com" target="_blank" rel="noopener">WhoIsAlexMerced.com</a></li>
            <li><a href="https://alexmercedmedia.com" target="_blank" rel="noopener">AlexMercedMedia.com</a></li>
            <li><a href="https://books.alexmerced.com" target="_blank" rel="noopener">Books by Alex Merced</a></li>
            <li><a href="https://alexmercedcoder.dev" target="_blank" rel="noopener">AlexMercedCoder.dev</a></li>
            <li><a href="https://alexmercedlibertarian.com" target="_blank" rel="noopener">AlexMercedLibertarian.com</a></li>
          </ul>
        </div>
        <p class="copyright">&copy; {new Date().getFullYear()} SemanticLakehouse.com. Built with Astro.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .navbar {
    background-color: var(--surface-frosted-pane);
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    font-family: var(--font-grandslang);
    font-weight: 700;
    font-size: 1.8rem;
    color: var(--color-cloud-whisper);
    letter-spacing: -0.03em;
  }
  [data-theme='dark'] .logo {
    color: var(--secondary);
  }
  .nav-links {
    list-style: none;
    display: flex;
    gap: 1.5rem;
  }
  .nav-links a {
    font-weight: 500;
    color: var(--text-color);
  }
  .nav-links a:hover {
    color: var(--secondary);
  }
  .nav-links a[aria-current='page'] {
    color: var(--secondary);
    border-bottom: 2px solid var(--secondary);
    padding-bottom: 2px;
  }
  @media (max-width: 720px) {
    .nav-container {
      flex-direction: column;
      gap: 1rem;
    }
    .nav-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }
    .logo {
      font-size: 1.35rem;
    }
  }
  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
  }
  .footer-nav a {
    color: var(--color-cloud-whisper);
    font-weight: 500;
  }
  .footer-nav a:hover {
    color: var(--color-deep-violet);
  }
  .footer-about {
    text-align: center;
    max-width: 640px;
    font-size: 0.95rem;
  }
  .footer-about a {
    color: var(--color-deep-violet);
  }
  footer {
    padding: 4rem 0 2rem;
    margin-top: 4rem;
    background-color: var(--surface-deep-space-canvas);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--color-slate-hint);
  }
  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }
  .footer-links {
    text-align: center;
  }
  .footer-links .footer-heading {
    color: var(--color-cloud-whisper);
    margin-bottom: 1rem;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.4;
    font-family: var(--font-whyte-inktrap-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .footer-links ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
  }
  .footer-links a {
    color: var(--color-slate-hint);
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }
  .footer-links a:hover {
    color: var(--color-deep-violet);
  }
  .copyright {
    font-size: 0.85rem;
  }
</style>
